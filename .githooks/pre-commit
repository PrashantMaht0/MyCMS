#!/bin/sh
# Checks only: it never edits a file or makes a commit. Enable with: git config core.hooksPath .githooks
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
status=0

echo "pre-commit: swift-format lint"
xcrun swift-format lint --strict --recursive MyCMS MyCMSTests || status=1

if command -v swiftlint >/dev/null 2>&1; then
    echo "pre-commit: swiftlint"
    swiftlint lint --strict --quiet || status=1
else
    echo "pre-commit: swiftlint is not installed, so the house rules were skipped (brew install swiftlint)"
fi

echo "pre-commit: build"
xcodebuild -scheme MyCMS -destination 'platform=macOS' -quiet build || status=1

if [ "$status" -ne 0 ]; then
    echo "pre-commit: commit blocked. Fix what is listed above, then commit again."
fi
exit "$status"
